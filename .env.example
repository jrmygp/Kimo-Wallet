# Copy to .env and fill in local values. Never commit the real .env file.
# This file is read by docker-compose.yml only. Each service reads its own
# .env from its own directory (see e.g. apps/user-service/.env.example) —
# not this one.

# docker-compose.yml — user-service's Postgres
USER_DB_USER=kimo
USER_DB_PASSWORD=changeme
USER_DB_NAME=kimo_user
USER_DB_PORT=5433

# docker-compose.yml — wallet-service's Postgres
WALLET_DB_USER=kimo
WALLET_DB_PASSWORD=changeme
WALLET_DB_NAME=kimo_wallet
WALLET_DB_PORT=5434

# docker-compose.yml — Kafka (single-node KRaft mode)
KAFKA_PORT=9092
