# Copy to apps/user-service/.env for local dev. Never commit the real .env
# file. Loaded automatically from the working directory by cmd/server/main.go
# (github.com/joho/godotenv) — real environment variables always win over
# these, so this is only a local convenience, not how production is configured.
#
# Values here must match the Postgres container's credentials — see the root
# .env.example / docker-compose.yml (USER_DB_*).

USER_SERVICE_DATABASE_URL=postgres://kimo:changeme@localhost:5433/kimo_user?sslmode=disable
USER_SERVICE_GRPC_PORT=50051

# HS256 signing key for access tokens. Must be the EXACT same value as
# api-gateway's JWT_SECRET (apps/api-gateway/.env) — user-service signs
# with this, api-gateway verifies with the same secret. This placeholder is
# fine for local dev only; a real deploy needs a properly random secret,
# e.g. `openssl rand -base64 32`.
JWT_SECRET=dev-only-shared-secret-please-change-in-real-deploys
