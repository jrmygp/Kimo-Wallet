# Copy to apps/transaction-service/.env for local dev. Never commit the
# real .env file. Loaded automatically from the working directory by
# cmd/server/main.go (github.com/joho/godotenv) — real environment
# variables always win over these, so this is only a local convenience,
# not how production is configured.
#
# Values here must match the Postgres container's credentials — see the
# root .env.example / docker-compose.yml (add a TRANSACTION_DB_* block
# there and its own service, same as WALLET_DB_*/wallet-db).

TRANSACTION_SERVICE_DATABASE_URL=postgres://kimo:changeme@localhost:5435/kimo_transaction?sslmode=disable
TRANSACTION_SERVICE_GRPC_PORT=50053

# wallet-service's gRPC address — used to confirm a sender/receiver has a
# wallet before creating a transaction. Must point at a running
# wallet-service instance.
WALLET_SERVICE_GRPC_ADDR=localhost:50052
