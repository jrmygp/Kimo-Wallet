# Copy to apps/<your-service>/.env for local dev. Never commit the real
# .env file. Loaded automatically from the working directory by
# cmd/server/main.go (github.com/joho/godotenv) — real environment
# variables always win over these, so this is only a local convenience,
# not how production is configured.
#
# TEMPLATE NOTE: rename every SERVICE_TEMPLATE_* variable to your
# service's own prefix (see README.md), and add a matching <NAME>_DB_*
# block to the root .env.example / docker-compose.yml for its own
# Postgres container — a service owns its data (docs/CLAUDE.md §4 rule 1),
# never a database shared with another service.

SERVICE_TEMPLATE_DATABASE_URL=postgres://kimo:changeme@localhost:5435/kimo_service_template?sslmode=disable
SERVICE_TEMPLATE_GRPC_PORT=50053
