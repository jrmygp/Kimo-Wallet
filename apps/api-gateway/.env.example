# Copy to apps/api-gateway/.env for local dev. Never commit the real .env
# file. Loaded automatically from the working directory by cmd/server/main.go
# (github.com/joho/godotenv) — real environment variables always win over
# these.

API_GATEWAY_HTTP_PORT=8080
USER_SERVICE_GRPC_ADDR=localhost:50051

# HS256 verification key for access tokens. Must be the EXACT same value as
# user-service's JWT_SECRET (apps/user-service/.env) — user-service signs
# with this secret, api-gateway verifies with it. This placeholder is fine
# for local dev only; a real deploy needs a properly random secret, e.g.
# `openssl rand -base64 32`.
JWT_SECRET=dev-only-shared-secret-please-change-in-real-deploys
