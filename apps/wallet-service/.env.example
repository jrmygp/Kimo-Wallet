# Copy to apps/wallet-service/.env for local dev. Never commit the real .env
# file. Loaded automatically from the working directory by cmd/server/main.go
# (github.com/joho/godotenv) — real environment variables always win over
# these, so this is only a local convenience, not how production is configured.
#
# Values here must match the Postgres container's credentials — see the root
# .env.example / docker-compose.yml (WALLET_DB_*).

WALLET_SERVICE_DATABASE_URL=postgres://kimo:changeme@localhost:5434/kimo_wallet?sslmode=disable

# Both optional — see internal/config/config.go for their defaults
# (localhost:9092 / "wallet-service").
# WALLET_SERVICE_KAFKA_BROKERS=localhost:9092
# WALLET_SERVICE_KAFKA_CONSUMER_GROUP=wallet-service
